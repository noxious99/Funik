PORT=8000
# Comma-separated list of allowed client origins (defaults to "*")
CORS_ORIGIN=http://localhost:5173
# MongoDB Atlas connection string. Leave empty to run guest-only (no accounts, stats or leaderboard).
MONGODB_URI=
# Required when MONGODB_URI is set. At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
